# Core service
WEB_HOST=0.0.0.0
WEB_PORT=8020
LOG_LEVEL=INFO
DETERMINFLOW_DATA_DIR=./data
DETERMINFLOW_LOGS_DIR=./logs
DETERMINFLOW_CONFIG_DIR=./config

# Model provider credentials. Keep values in the environment, not JSON config.
# 必填：自动化写作的正文/代理模型供应商（DeepSeek）。
# 注意：.env 已在 .gitignore 中，切勿把真实密钥提交到仓库。
DEEPSEEK_API_KEY=
MIMO_API_KEY=
ALIBABA_API_KEY=
OPENAI_API_KEY=

# Comma-separated extension IDs. Use "none" for a Core-only runtime.
# 小说自动化需要 bishu-novel 插件：DETERMINFLOW_EXTENSIONS=bishu-novel
DETERMINFLOW_EXTENSIONS=none

# ---- pipeline.py 可移植性配置（均可选，留空用内置默认）----
# PostgreSQL 可执行目录 / 数据目录 / 日志文件（默认本机 D:/pg17 路径，其他机器请覆盖）
PG_BIN_DIR=
PG_DATA_DIR=
PG_LOG_FILE=
# 章节 txt 输出目录（默认 D:/DeterminFlow-output）
OUTPUT_DIR=
# 默认书名（pipeline.py --book 未指定时使用）
DEFAULT_BOOK=
# 每天产出章节数（默认 2）
CHAPTERS_PER_BATCH=
# 余额熔断阈值（元，默认 1.0）/ 单批 token 上限（默认 200000）
MIN_BALANCE=
MAX_TOKENS=

# Optional browser and workspace settings
# CORS_ORIGINS=http://localhost:5173
# CORS_ALLOW_ALL=false
# CODING_WORKSPACE_COPY_ON_CREATE=true
